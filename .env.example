# ============================================================
# .env.example — Copy this to .env and fill in your keys
# ============================================================

# B-Roll Video Sources
PEXELS_API_KEY=           # free at pexels.com/api
PIXABAY_API_KEY=          # free at pixabay.com/api
COVERR_API_KEY=           # optional — free at coverr.co/api

# AI Services
GEMINI_API_KEY=           # free at aistudio.google.com

# YouTube Data API v3 (free — 100 searches/day, dramatically improves B-roll)
# Get key: console.cloud.google.com → Enable "YouTube Data API v3" → API Key
YOUTUBE_API_KEY=
