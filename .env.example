# ============================================================
# .env.example — Copy this to .env and fill in your keys
# ============================================================

# B-Roll Video Sources
PEXELS_API_KEY=           # free at pexels.com/api
PIXABAY_API_KEY=          # free at pixabay.com/api
COVERR_API_KEY=           # optional — free at coverr.co/api

# Groq API — 7 keys from different accounts for automatic rotation
# Paste multiple comma-separated keys for rate limit rotation: key1,key2,key3...
# Free: 14,400 req/day per account × 7 accounts = ~100,800 req/day combined
GROQ_API_KEYS=

